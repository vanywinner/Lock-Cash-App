# Copy to /etc/lock-cash.env (on the server) and fill in.
PORT=3000
BASE_PATH=/lock-cash
DB_FILE=/var/lib/lock-cash/lockcash.db
POCHI_PHONE=0700 000 000
POCHI_NAME=Your name as it shows on Pochi
SUPPORT_PHONE=+254700000000
# Family-only sign-up: members must type this code. Share it privately (WhatsApp family group).
INVITE_CODE=choose-a-family-code
COOKIE_SECURE=1
TRUST_PROXY=1
